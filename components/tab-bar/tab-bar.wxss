.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.item {
  flex: 1;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8e8e8e;
}

.item.on {
  color: #0d3b66;
}

.icon {
  width: 44rpx;
  height: 44rpx;
  margin-bottom: 6rpx;
}

.lab {
  font-size: 20rpx;
  line-height: 1;
  font-weight: 500;
}

.icon-codes {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-content: space-between;
}

.icon-codes .sq {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.icon-plus {
  border: 3rpx solid currentColor;
  border-radius: 50%;
  position: relative;
}

.icon-plus::before,
.icon-plus::after {
  content: "";
  position: absolute;
  background: currentColor;
  left: 50%;
  top: 50%;
}

.icon-plus::before {
  width: 18rpx;
  height: 3rpx;
  margin-left: -9rpx;
  margin-top: -1.5rpx;
}

.icon-plus::after {
  width: 3rpx;
  height: 18rpx;
  margin-left: -1.5rpx;
  margin-top: -9rpx;
}

.icon-me {
  position: relative;
}

.icon-me::before {
  content: "";
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  left: 50%;
  top: 2rpx;
  margin-left: -10rpx;
}

.icon-me::after {
  content: "";
  position: absolute;
  width: 26rpx;
  height: 12rpx;
  border: 3rpx solid currentColor;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
  left: 50%;
  bottom: 2rpx;
  margin-left: -16rpx;
}
