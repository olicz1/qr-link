.page {
  padding: 24rpx 24rpx 140rpx;
}

.picker {
  background: #fff;
  border-radius: 24rpx;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview {
  width: 400rpx;
  height: 400rpx;
}

.placeholder {
  text-align: center;
  color: #191919;
  font-size: 30rpx;
}

.plus {
  width: 96rpx;
  height: 96rpx;
  line-height: 88rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: #e8f8ee;
  color: #07c160;
  font-size: 56rpx;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.form {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.label {
  width: 140rpx;
  font-size: 30rpx;
}

.row input {
  flex: 1;
  font-size: 30rpx;
}

.block {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #f7f7f7;
  font-size: 24rpx;
}

.chip.on {
  background: #07c160;
  color: #fff;
}

.action {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fafafa;
}

.action.on {
  background: #e8f8ee;
}

.action-title {
  font-size: 28rpx;
  font-weight: 500;
}

.action-hint {
  font-size: 22rpx;
  color: #888;
}

.save {
  margin-top: 32rpx;
  background: #07c160;
  color: #fff;
  border-radius: 16rpx;
}

.save::after {
  border: none;
}
