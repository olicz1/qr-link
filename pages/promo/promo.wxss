.page {
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.hero {
  background: #0d3b66;
  color: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
}

.kicker {
  font-size: 24rpx;
  opacity: 0.85;
}

.title {
  font-size: 44rpx;
  font-weight: 500;
  margin-top: 8rpx;
}

.sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.row {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.row:last-child {
  border-bottom: none;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
}

.desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #888;
}
