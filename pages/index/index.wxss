.page {
  padding: 24rpx 24rpx 0;
}

.hero {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
}

.en {
  font-size: 22rpx;
  color: #888;
}

.zh {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
}

.hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
  line-height: 1.5;
}

.count {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #e8eef5;
  color: #0d3b66;
  font-size: 20rpx;
}

.filters {
  width: 100%;
  height: 80rpx;
  margin-top: 20rpx;
}

.filters-inner {
  display: inline-block;
  white-space: nowrap;
  height: 80rpx;
  padding: 12rpx 0;
}

.chip {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #191919;
  font-size: 24rpx;
  vertical-align: top;
}

.chip.on {
  background: #0d3b66;
  color: #fff;
  font-weight: 500;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 16rpx -10rpx 0;
}

.cell {
  width: 50%;
  padding: 10rpx;
}

.card {
  position: relative;
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.pin {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  z-index: 3;
  height: 36rpx;
  padding: 0 12rpx;
  line-height: 36rpx;
  border-radius: 999rpx;
  background: #0d3b66;
  color: #fff;
  font-size: 18rpx;
}

.more {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 3;
  width: 48rpx;
  height: 48rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.94);
  color: #666;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.menu {
  position: absolute;
  top: 68rpx;
  right: 12rpx;
  z-index: 4;
  width: 176rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.menu-item {
  padding: 20rpx 24rpx;
  font-size: 26rpx;
}

.menu-item.danger {
  color: #fa5151;
  border-top: 1rpx solid rgba(0, 0, 0, 0.06);
}

.media {
  padding: 20rpx 20rpx 8rpx;
  background: #fafafa;
}

.qr {
  display: block;
  width: 100%;
  height: 260rpx;
}

.meta {
  padding: 12rpx 18rpx 20rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sub {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: #888;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag {
  display: inline-block;
  margin-top: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  color: #fff;
  background: #57534e;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  padding: 0 48rpx;
}

.empty-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  line-height: 112rpx;
  border-radius: 50%;
  background: #fff;
  color: #0d3b66;
  font-size: 40rpx;
  font-weight: 600;
}

.empty-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 500;
}

.empty-copy {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  max-height: 86%;
  overflow-y: auto;
  background: #f7f7f7;
  border-radius: 32rpx 32rpx 0 0;
  padding: 16rpx 40rpx 24rpx;
}

.handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.15);
  margin: 8rpx auto 24rpx;
}

.shop-en,
.code-title,
.note,
.ok-id,
.ok-sub,
.ok-shop,
.amt-hint {
  text-align: center;
  color: #888;
  font-size: 24rpx;
}

.shop-en {
  font-size: 22rpx;
}

.shop {
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
}

.code-title,
.note {
  margin-top: 8rpx;
}

.amt-row {
  display: flex;
  justify-content: center;
  align-items: baseline;
  margin: 20rpx 0 0;
}

.yen {
  font-size: 40rpx;
  font-weight: 500;
}

.amt {
  font-size: 72rpx;
  font-weight: 500;
  width: 280rpx;
  text-align: center;
}

.amt-hint {
  margin-top: 4rpx;
  color: #b2b2b2;
}

.sheet-qr-wrap {
  width: 360rpx;
  margin: 24rpx auto 0;
  padding: 20rpx;
  background: #fff;
  border-radius: 24rpx;
}

.stripe {
  height: 6rpx;
  border-radius: 6rpx;
  margin-bottom: 16rpx;
}

.sheet-qr {
  display: block;
  width: 100%;
  height: 320rpx;
}

.stripe-lab {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 500;
}

.payload {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  white-space: pre-wrap;
}

.sheet-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.sheet-row .wx-btn {
  width: 48%;
  margin-top: 0;
}

.wx-btn {
  margin-top: 28rpx;
}

.wx-btn-ghost {
  margin-top: 16rpx;
}

.ok-mark {
  width: 112rpx;
  height: 112rpx;
  margin: 32rpx auto 0;
  line-height: 112rpx;
  text-align: center;
  border-radius: 50%;
  background: #0d3b66;
  color: #fff;
  font-size: 56rpx;
}

.ok {
  text-align: center;
  font-size: 40rpx;
  font-weight: 500;
  margin-top: 24rpx;
}

.ok-sub,
.ok-shop {
  margin-top: 6rpx;
}

.ok-amt {
  text-align: center;
  font-size: 64rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.ok-id {
  margin: 16rpx 0 8rpx;
}
