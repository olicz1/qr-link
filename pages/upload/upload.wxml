<view class="page" style="padding-bottom: {{pagePad}}px;">
  <view class="picker" bindtap="choose">
    <image wx:if="{{image}}" class="preview" src="{{image}}" mode="aspectFit" />
    <view wx:else class="placeholder">
      <view class="plus">+</view>
      <view class="ph-title">扫一扫或选一张码</view>
      <view class="sub">微信原生扫码，不用长按。点卡片会直接打开。</view>
    </view>
  </view>

  <view class="scan-btn" bindtap="scan">扫一扫添加</view>
  <view class="pick-row">
    <view class="pick-btn" data-source="album" bindtap="choose">相册</view>
    <view class="pick-btn" data-source="camera" bindtap="choose">拍照</view>
  </view>
  <view class="scan-wait" wx:if="{{recognizing}}">正在识别…</view>
  <view class="scan-ok" wx:elif="{{payload}}">已识别，点卡片会直接打开</view>

  <view class="form">
    <view class="row">
      <text class="label">名称</text>
      <input placeholder="小区停车" value="{{title}}" bindinput="onTitle" />
    </view>
    <view class="row">
      <text class="label">副标题</text>
      <input placeholder="B2 出口" value="{{subtitle}}" bindinput="onSubtitle" />
    </view>
    <view class="block last">
      <view class="label muted">标签</view>
      <view class="chips">
        <view
          wx:for="{{channels}}"
          wx:key="id"
          class="chip chip-{{item.id}} {{channel === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="setChannel"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <button class="wx-btn save" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存到码柜</button>
</view>
