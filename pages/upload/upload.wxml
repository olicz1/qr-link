<view class="page" style="padding-bottom: {{pagePad}}px;">
  <view class="picker" bindtap="choose">
    <image wx:if="{{image}}" class="preview" src="{{image}}" mode="aspectFit" />
    <view wx:else class="placeholder">
      <view class="plus">+</view>
      <view class="ph-title">选择一张二维码</view>
      <view class="sub">相册或相机 · 微信、支付宝或其他收款码</view>
    </view>
  </view>

  <view class="pick-row">
    <view class="pick-btn" data-source="album" bindtap="choose">相册</view>
    <view class="pick-btn" data-source="camera" bindtap="choose">拍照</view>
  </view>

  <view class="form">
    <view class="row">
      <text class="label">名称</text>
      <input placeholder="微信收款" value="{{title}}" bindinput="onTitle" />
    </view>
    <view class="row">
      <text class="label">副标题</text>
      <input placeholder="柜台 · 微信支付" value="{{subtitle}}" bindinput="onSubtitle" />
    </view>
    <view class="block">
      <view class="label muted">渠道</view>
      <view class="chips">
        <view
          wx:for="{{channels}}"
          wx:key="id"
          class="chip chip-{{item.id}} {{channel === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="setChannel"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="block">
      <view class="label muted">点按后</view>
      <view
        wx:for="{{actions}}"
        wx:key="id"
        class="action {{action === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="setAction"
      >
        <view class="action-title">{{item.label}}</view>
        <view class="action-hint">{{item.hint}}</view>
      </view>
    </view>
    <view class="row" wx:if="{{action === 'payment'}}">
      <text class="label">默认 ¥</text>
      <input type="digit" placeholder="18.00" value="{{amount}}" bindinput="onAmount" />
    </view>
    <view class="block last">
      <view class="label muted">备注</view>
      <input class="note" placeholder="显示在弹层上" value="{{note}}" bindinput="onNote" />
    </view>
  </view>

  <button class="wx-btn save" bindtap="save">保存到码柜</button>
  <tab-bar active="upload" />
</view>
