.page {
  padding: 24rpx 24rpx 0;
}

.picker {
  background: #fff;
  border-radius: 24rpx;
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview {
  width: 400rpx;
  height: 400rpx;
}

.placeholder {
  text-align: center;
  color: #191919;
}

.plus {
  width: 96rpx;
  height: 96rpx;
  line-height: 88rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: #e8eef5;
  color: #0d3b66;
  font-size: 56rpx;
}

.ph-title {
  font-size: 30rpx;
  font-weight: 500;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #888;
}

.scan-btn {
  margin-top: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #0d3b66;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.scan-wait,
.scan-ok {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
}

.scan-wait {
  color: #888;
}

.scan-ok {
  color: #07c160;
}

.pick-row {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.pick-btn {
  width: 48.5%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.form {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 30rpx;
}

.label.muted {
  width: auto;
  color: #888;
  font-size: 26rpx;
}

.row input {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
}

.block {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.block.last {
  border-bottom: none;
}

.chips {
  margin: 16rpx -8rpx 0;
}

.chip {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  margin: 8rpx;
  border-radius: 999rpx;
  background: #f7f7f7;
  font-size: 24rpx;
  vertical-align: top;
}

.chip.on {
  color: #fff;
  background: #0d3b66;
}

.chip-parking.on { background: #0d3b66; }
.chip-dining.on { background: #c2410c; }
.chip-hotel.on { background: #6d28d9; }
.chip-shopping.on { background: #0f766e; }
.chip-transit.on { background: #0369a1; }
.chip-other.on { background: #57534e; }

.save {
  margin-top: 32rpx;
}

.save[disabled] {
  opacity: 0.7;
}
